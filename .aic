# markdown-display release (build logic lives in scripts/build.ts)

[ignore]
dist/**
artifacts/**

[release]
bun run build

[publish]
VERSION=$(bun -p 'require("./package.json").version') && \
gh release create "v${VERSION}" \
  artifacts/md-${VERSION}.tar.gz \
  artifacts/checksums.txt \
  --title "v${VERSION}" \
  --notes "$(aic changelog-latest)"

cp Formula/md.rb ../tap/Formula/md.rb && \
cd ../tap && git add Formula/md.rb && \
git commit -m "md ${VERSION}" && git push
