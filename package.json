{
  "name": "@seanmozeik/markdown-display",
  "version": "0.4.2",
  "description": "Beautiful terminal markdown viewer",
  "keywords": [
    "bun",
    "cli",
    "effect",
    "markdown",
    "terminal"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanmozeik/markdown-display.git"
  },
  "bin": {
    "md": "./dist/md.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:release": "bun scripts/build.ts -- --release",
    "build:themes": "bun scripts/build-themes.ts",
    "check": "bun run format && bun run lint:fix && bun run typecheck",
    "dev": "bun run src/cli.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "tc": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "lint": "oxlint --format agent --tsconfig tsconfig.oxlint.json ./src ./tests ./scripts",
    "lint:fix": "oxlint --format agent --tsconfig tsconfig.oxlint.json --fix ./src ./tests ./scripts",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@clack/prompts": "1.4.0",
    "@effect/platform-bun": "^4.0.0-beta.66",
    "@shikijs/cli": "^4.0.2",
    "boxen": "^8.0.1",
    "console-table-printer": "^2.15.0",
    "effect": "^4.0.0-beta.66",
    "fuzzysort": "^3.1.0",
    "gradient-string": "^3.0.0",
    "hyphen": "^1.14.1",
    "marked": "^17.0.6",
    "shiki": "^4.0.2",
    "supports-color": "^10.2.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.1",
    "@types/gradient-string": "^1.1.6",
    "@types/hyphen": "^1.14.0",
    "bun-types": "1.3.14",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.65.0",
    "oxlint-tsgolint": "^0.23.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
